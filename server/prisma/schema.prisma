generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Game {
  id           String   @id @default(uuid())
  gameType     String
  boardState   String
  moveHistory  String
  status       String   @default("playing")
  winner       String?
  analysisJson String?
  aiProvider   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
