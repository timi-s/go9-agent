# ===== 服务端环境变量示例（复制为 .env 后按需修改）=====

# HTTP 端口
PORT=3001

# SQLite 数据库文件。相对路径按 server 目录解析，也支持绝对路径。
DATABASE_URL="file:./dev.db"

# 设为 1 时完全跳过数据库，仅内存运行（测试 / 演示用）
# DISABLE_DB=1

# 允许跨域的前端来源，默认 *（开发）。生产建议填写具体域名。
# CORS_ORIGIN=http://localhost:5173

# ===== AI（Agent）接入 =====
# 默认 provider：heuristic（内置 Python MCTS）| http（OpenAI 兼容）| katago（本地引擎）
AI_PROVIDER_DEFAULT=heuristic

# --- 内置 Python AI（server/ai/go_ai.py）---
# Python 解释器：默认自动探测（Windows: python/py，其它: python3/python）
# LOCAL_AI_PYTHON=python
# LOCAL_AI_SCRIPT=C:\path\to\go_ai.py
# 单次调用超时（超时自动回退 JS 内置 AI）
# LOCAL_AI_TIMEOUT_MS=8000
# 固定随机种子（便于复现）
# LOCAL_AI_SEED=2026

# --- DeepSeek（OpenAI 兼容，推荐入门）---
# AI_PROVIDER_DEFAULT=http
# AI_HTTP_BASE_URL=https://api.deepseek.com/v1
# AI_HTTP_MODEL=deepseek-chat
# AI_HTTP_API_KEY=sk-你的key
# AI_HTTP_TIMEOUT_MS=20000
# # 模型给出非法/已占着点时，自动回灌错误并重试一次（默认 1，设 0 关闭）
# AI_HTTP_RETRY=1
# 验证：cd server && npm run ai:check

# --- 其它 OpenAI 兼容服务（Ollama / LM Studio / vLLM / 自建）---
# AI_HTTP_BASE_URL=http://127.0.0.1:11434/v1
# AI_HTTP_MODEL=qwen2.5:7b
# AI_HTTP_API_KEY=            # 本地服务一般留空
# AI_HTTP_TIMEOUT_MS=15000
# # 若接口路径不是 /chat/completions：
# AI_HTTP_PATH=/chat/completions

# --- KataGo（本地 GTP 引擎）---
# KATAGO_CMD=C:\tools\katago\katago.exe
# KATAGO_ARGS=gtp -model C:\tools\katago\model.bin.gz -config C:\tools\katago\gtp.cfg
# KATAGO_TIMEOUT_MS=15000
