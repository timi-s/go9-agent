{
  "name": "go9-agent",
  "version": "2.4.1",
  "private": true,
  "description": "九路围棋 Web 应用：React + Vite 前端，Express + Prisma 后端，可插拔 AI（内置/HTTP/KataGo）与赛后复盘分析",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --only server",
    "dev:client": "node scripts/dev.mjs --only client",
    "test": "node --test --test-isolation=none server/tests/",
    "build": "node scripts/build.mjs"
  }
}
